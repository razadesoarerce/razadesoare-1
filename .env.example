# Cloudinary (unsigned uploads – no API secret in frontend)
# Create an unsigned upload preset in Cloudinary Dashboard → Settings → Upload
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=unsigned_upload_preset

# ── Vercel (serverless) – ștergere imagini din Cloudinary (/api/cloudinary/delete)
# Dashboard Vercel → Project → Settings → Environment Variables
# Cloudinary → Dashboard → API Keys (Cloud name, API Key, API Secret)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
